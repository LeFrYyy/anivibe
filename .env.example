# Переменные окружения для СЕРВЕРНОЙ части / инструментов (Supabase CLI, скрипты).
# Этот файл НЕ используется iOS-приложением: приложение читает конфигурацию из
# Config/Secrets.xcconfig (см. README → «Настройка конфигурации»).
# Скопируйте в .env и заполните. .env добавлен в .gitignore.

# Ссылка на проект Supabase (Project Settings → General → Reference ID)
SUPABASE_PROJECT_REF=your-project-ref

# URL API проекта (Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Публичный ключ (anon / publishable). Его же кладут в Config/Secrets.xcconfig.
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Пароль базы данных — нужен только для `supabase db push` / `supabase link`.
# НИКОГДА не помещайте его (и service_role / secret-ключ) в iOS-приложение.
SUPABASE_DB_PASSWORD=change-me

# Строка подключения для локальной проверки RLS (supabase/tests/rls_test.sh)
PGURL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# SMTP / Google: these are SERVER settings, not values for iOS Info.plist.
# Hosted Supabase: enter them in Authentication settings. Self-host: map to GOTRUE_*.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-transactional-smtp-user
SMTP_PASS=replace-with-transactional-smtp-password
SMTP_ADMIN_EMAIL=no-reply@example.com
SMTP_SENDER_NAME=Anivibe
GOOGLE_CLIENT_ID=replace-with-google-web-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-web-client-secret
API_EXTERNAL_URL=https://api.example.com
APP_PUBLIC_URL=https://app.example.com

// Скопируйте этот файл в Config/Secrets.xcconfig и подставьте свои значения.
// Secrets.xcconfig в .gitignore — не коммитьте его.
//
// НИКОГДА не указывайте здесь service_role / secret-ключ Supabase: он даёт полный доступ
// к базе в обход RLS. В приложение кладётся только публичный anon (publishable) ключ.

PRODUCT_BUNDLE_IDENTIFIER = com.yourname.anivibe
DEVELOPMENT_TEAM = YOUR_TEAM_ID

// «$()» нужен, чтобы xcconfig не воспринял «//» как комментарий.
// Defaults are already set in Supabase.xcconfig; uncomment only to switch projects.
// ANIVIBE_SUPABASE_URL = https:/$()/YOUR_PROJECT_REF.supabase.co
// ANIVIBE_SUPABASE_ANON_KEY = YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

// ANIVIBE_MANIFEST_URL = https:/$()/your-cdn.example.com/anivibe/manifest.json
// ANIVIBE_DEMO_CATALOG = YES

// Токен Kodik API с kodik.biz (включает раздел «Озвучки онлайн» с веб-плеером Kodik).
// ANIVIBE_KODIK_TOKEN = YOUR_KODIK_API_TOKEN

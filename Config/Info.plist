<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Anivibe</string>
	<key>AnivibeSupabaseURL</key>
	<string>$(ANIVIBE_SUPABASE_URL)</string>
	<key>AnivibeSupabaseAnonKey</key>
	<string>$(ANIVIBE_SUPABASE_ANON_KEY)</string>
	<key>AnivibeManifestURL</key>
	<string>$(ANIVIBE_MANIFEST_URL)</string>
	<key>AnivibeDemoCatalog</key>
	<string>$(ANIVIBE_DEMO_CATALOG)</string>
	<key>AnivibeTestStreams</key>
	<string>$(ANIVIBE_TEST_STREAMS)</string>
	<key>AnivibeKodikToken</key>
	<string>$(ANIVIBE_KODIK_TOKEN)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Разрешает только http к localhost (локальный Supabase в симуляторе). ATS для интернета не ослабляется. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>

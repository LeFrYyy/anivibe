index 0000000000000000000000000000000000000000..946964a97888fc9acdae0e5bcfe73adaca8d1a4e
--- /dev/null
+++ b/Packages/AnivibeCore/Sources/AnivibeCore/Community/CommunityModels.swift
@@ -0,0 +1,224 @@
+import Foundation
+
+public struct FriendshipLevel: Codable, Sendable, Equatable {
+    public let level: Int
+    public let xp: String
+    public let inLevel: String
+    public let needed: String
+    public let progress: Double
+}
+public struct CommunityFriend: Decodable, Sendable, Identifiable {
+    public var id: String { peerId }
+    public let peerId: String
+    public let name: String
+    public let username: String?
+    public let avatarPath: String?
+    public let level: FriendshipLevel
+    public let episodes: Int
+    public let startedAt: String
+    public let lastWatchAt: String?
+    public let dailyCompleted: Int
+    public let dailyRewarded: Bool
+    public let watching: Bool?
+}
+public struct CommunityItem: Decodable, Sendable, Identifiable {
+    public let id: String
+    public let name: String
+    public let category: String
+    public let price: Int
+    public let cap: Int?
+    public let prerequisite: String?
+    public let assetKey: String?
+    public let mime: String?
+    public let posterKey: String?
+    public let available: Bool
+    public let owned: Bool
+    public let equipped: Bool
+    public var slot: String? {
+        switch category { case "avatar": return "avatar"; case "banner", "animated_banner": return "banner"; default: return nil }
+    }
+}
+public struct CommunityNotice: Decodable, Sendable, Identifiable {
+    public struct Payload: Decodable, Sendable {
+        public let peerId: String?
+        public let sessionId: String?
+        public let level: Int?
+        public let xp: Int?
+        public let coins: Int?
+        public let state: String?
+        public let reason: String?
+    }
+    public let id: String
+    public let kind: String
+    public let createdAt: String
+    public let read: Bool
+    public let payload: Payload
+    public var title: String {
+        switch kind {
+        case "friend_request": return "Новая заявка в друзья"
+        case "friend_accepted": return "Заявка в друзья принята"
+        case "watch_invite": return "Приглашение смотреть вместе"
+        case "episode_reward": return "Серия засчитана · +\(payload.xp ?? 0) XP · +\(payload.coins ?? 0) монет"
+        case "daily_reward": return "Задание выполнено · +\(payload.xp ?? 0) XP · +\(payload.coins ?? 0) монет"
+        case "level_up": return "Дружба достигла уровня \(payload.level ?? 1)"
+        case "comment_moderated": return payload.state == "hidden" ? "Комментарий скрыт модератором" : "Комментарий восстановлен"
+        default: return "Обновление Anivibe"
+        }
+    }
+}
+public struct CommunityHub: Decodable, Sendable {
+    public let userId: String
+    public let balance: Int
+    public let friendCap: Int
+    public let day: String
+    public let dailyGoal: Int
+    public let dailyXp: Int
+    public let dailyCoins: Int
+    public let invitePolicy: String
+    public let hideWatching: Bool
+    public let uniqueEpisodes: Int
+    public let friends: [CommunityFriend]
+    public let items: [CommunityItem]
+    public let sessions: [WatchRoom]
+    public let notifications: [CommunityNotice]
+}
+public struct CanonicalWatchEpisode: Decodable, Sendable, Identifiable {
+    public let id: String
+    public let animeId: String
+    public let anilistId: Int?
+    public let animeTitle: String
+    public let label: String
+    public let kind: String
+    public let sortOrder: Int
+    public let duration: Double?
+    public let verified: Bool
+    public let sources: [WatchSourceMapping]
+}
+public struct WatchSourceMapping: Decodable, Sendable, Identifiable {
+    public let id: String
+    public let providerId: String
+    public let voice: String
+    public let sourceOffset: Double
+    public let sourceEpisode: ProviderEpisode
+    public let verified: Bool
+    enum CodingKeys: String, CodingKey { case id, providerId, voice, sourceOffset, sourceEpisode, verified }
+    public init(from decoder: Decoder) throws {
+        let c = try decoder.container(keyedBy: CodingKeys.self)
+        id = try c.decode(String.self, forKey: .id); providerId = try c.decode(String.self, forKey: .providerId)
+        voice = try c.decode(String.self, forKey: .voice); sourceOffset = try c.decode(Double.self, forKey: .sourceOffset)
+        verified = try c.decode(Bool.self, forKey: .verified)
+        let wire = try c.decode(WatchProviderDescriptor.self, forKey: .sourceEpisode)
+        guard wire.providerID.rawValue == providerId else {
+            throw DecodingError.dataCorruptedError(forKey: .sourceEpisode, in: c, debugDescription: "Provider identity mismatch")
+        }
+        sourceEpisode = ProviderEpisode(providerID: ProviderID(rawValue: wire.providerID.rawValue), titleID: wire.titleID,
+            season: wire.season, number: wire.number, title: wire.title, payload: wire.payload)
+    }
+}
+private struct WatchProviderDescriptor: Decodable {
+    struct ProviderWire: Decodable {
+        let rawValue: String
+        enum CodingKeys: String, CodingKey { case rawValue }
+        init(from decoder: Decoder) throws {
+            if let scalar = try? decoder.singleValueContainer().decode(String.self) { rawValue = scalar }
+            else { let c = try decoder.container(keyedBy: CodingKeys.self); rawValue = try c.decode(String.self, forKey: .rawValue) }
+        }
+    }
+    let providerID: ProviderWire
+    let titleID: String
+    let season: Int?
+    let number: Int
+    let title: String?
+    let payload: String
+}
+public struct WatchRoom: Decodable, Sendable, Identifiable {
+    public struct Member: Decodable, Sendable, Identifiable {
+        public var id: String { userId }
+        public let userId: String
+        public let mappingId: String?
+        public let state: String
+        public let online: Bool?
+        public let watchedProgress: Double
+    }
+    public let id: String
+    public let hostId: String
+    public let guestId: String
+    public let status: String
+    public let episodeId: String
+    public let animeId: String
+    public let anilistId: Int?
+    public let animeTitle: String
+    public let episodeLabel: String
+    public let episodeOrder: Int
+    public let playback: String
+    public let wantsPlay: Bool
+    public let position: Double
+    public let serverTime: Double
+    public let revision: Int
+    public let duration: Double?
+    public let rewardsEligible: Bool
+    public let rewardBlockReason: String?
+    public let overlapProgress: Double
+    public let completionRatio: Double
+    public let overlapRatio: Double
+    public let rewarded: Bool
+    public let members: [Member]
+    public var rewardStatus: String {
+        if rewarded { return "Награда подтверждена сервером" }
+        switch rewardBlockReason {
+        case "untrusted_duration": return "Награды отключены: нет проверенной продолжительности"
+        case "untrusted_source": return "Для наград оба источника должны быть подтверждены"
+        case "awaiting_duration": return "Проверяем продолжительность видео у обоих участников"
+        default: return "Награда появится после подтверждения просмотра обоих участников"
+        }
+    }
+    public var isClosed: Bool { status == "closed" }
+    public func member(_ userId: String) -> Member? { members.first { $0.userId.lowercased() == userId.lowercased() } }
+}
+public struct PurchaseReceipt: Decodable, Sendable {
+    public let itemId: String
+    public let balance: Int
+    public let charged: Int
+    public let replayed: Bool
+}
+public struct CosmeticPresentation: Decodable, Sendable {
+    public struct Media: Decodable, Sendable { public let assetKey: String; public let posterKey: String?; public let mime: String }
+    public let avatar: Media?
+    public let banner: Media?
+}
+public enum CommunityError: Error, Sendable, Equatable {
+    case server(String), unavailable, wrongAccount
+    public var userMessage: String {
+        switch self {
+        case .wrongAccount: return "Аккаунт изменился. Откройте раздел заново."
+        case .unavailable: return "Социальная система пока не настроена на сервере."
+        case .server(let code):
+            switch code {
+            case "insufficient_coins": return "Недостаточно монет. Баланс не изменён."
+            case "prerequisite_required": return "Сначала купите улучшение до 15 друзей."
+            case "already_in_session": return "Один из участников уже в другой комнате. Сначала выйдите из неё."
+            case "mapping_missing", "episode_invalid": return "Для этой серии нет подтверждённого сопоставления источника. Выберите другой источник."
+            case "invites_disabled": return "Друг запретил приглашения или вы больше не друзья."
+            case "request_rate_limited": return "Слишком много запросов. Попробуйте немного позже."
+            case "session_expired": return "Комната закрыта из-за неактивности. Создайте новую."
+            case "item_unavailable": return "Предмет сейчас недоступен. Монеты не списаны."
+            case "request_conflict": return "Этот запрос уже использован для другой операции."
+            case "request_not_allowed": return "Недостаточно прав для этого действия."
+            default: return "Сервер не подтвердил действие. Обновите данные и повторите попытку."
+            }
+        }
+    }
+}
+/// Pure reconciliation, independent of the device's wall clock.
+public enum WatchReconciliation {
+    public static let seekTolerance: Double = 1.5
+    public static func target(anchor: Double, elapsed: TimeInterval, playing: Bool, duration: Double?) -> Double {
+        let safeAnchor = anchor.isFinite ? max(0, anchor) : 0
+        let safeElapsed = elapsed.isFinite ? min(30, max(0, elapsed)) : 0
+        let result = safeAnchor + (playing ? safeElapsed : 0)
+        return duration.map { $0.isFinite && $0 > 0 ? min($0, result) : result } ?? result
+    }
+    public static func needsSeek(local: Double, target: Double) -> Bool {
+        local.isFinite && target.isFinite && abs(local - target) > seekTolerance
+    }
+}
diff --git a/Packages/AnivibeCore/Sources/AnivibeCore/Community/SupabaseCommunityService.swift b/Packages/AnivibeCore/Sources/AnivibeCore/Community/SupabaseCommunityService.swift
new file mode 100644
index 0000000000000000000000000000000000000000..d7ae9a1f012769f99dc11265d8f8cc091f8cfc20
--- /dev/null
+++ b/Packages/AnivibeCore/Sources/AnivibeCore/Community/SupabaseCommunityService.swift
@@ -0,0 +1,161 @@
+import Foundation
+#if canImport(FoundationNetworking)
+import FoundationNetworking
+#endif
+
+/// Only authenticated public-key RPCs. Never contains service_role or a reward-setting API.
+public actor SupabaseCommunityService {
+    private let config: AppConfiguration.Supabase
+    private let auth: SupabaseAuthClient
+    private let transport: HTTPTransport
+    public init(config: AppConfiguration.Supabase, auth: SupabaseAuthClient, transport: HTTPTransport) {
+        self.config = config; self.auth = auth; self.transport = transport
+    }
+    public func hub(userId: String) async throws -> CommunityHub {
+        try await decode("anivibe_community_hub", body: [:], userId: userId)
+    }
+    public func episodes(anilistId: Int? = nil, after: Int = 0, userId: String) async throws -> [CanonicalWatchEpisode] {
+        try await decode("anivibe_episode_catalog", body: ["p_anilist": anilistId.map { $0 as Any } ?? NSNull(), "p_after": max(0, after), "p_limit": 100], userId: userId)
+    }
+    public func room(_ id: String, userId: String) async throws -> WatchRoom {
+        try await decode("anivibe_watch_get", body: ["p_session": id], userId: userId)
+    }
+    public func invite(peerId: String, episodeId: String, mappingId: String, requestId: UUID, userId: String) async throws -> WatchRoom {
+        try await decode("anivibe_watch_invite", body: ["p_peer": peerId, "p_episode": episodeId, "p_mapping": mappingId, "p_request": requestId.uuidString], userId: userId)
+    }
+    public func action(roomId: String, action: String, position: Double? = nil, episodeId: String? = nil, mappingId: String? = nil, userId: String) async throws -> WatchRoom {
+        try await decode("anivibe_watch_action", body: ["p_session": roomId, "p_action": action,
+            "p_value": position.map { $0 as Any } ?? NSNull(), "p_episode": episodeId.map { $0 as Any } ?? NSNull(),
+            "p_mapping": mappingId.map { $0 as Any } ?? NSNull()], userId: userId)
+    }
+    public func heartbeat(roomId: String, episodeId: String, mappingId: String, eventId: UUID, clientId: UUID, sequence: Int,
+                          position: Double, duration: Double, state: String, userId: String) async throws -> WatchRoom {
+        guard position.isFinite, duration.isFinite else { throw CommunityError.server("progress_invalid") }
+        return try await decode("anivibe_watch_heartbeat", body: ["p_session": roomId, "p_episode": episodeId, "p_mapping": mappingId,
+            "p_event": eventId.uuidString, "p_client": clientId.uuidString, "p_sequence": sequence, "p_position": max(0, position),
+            "p_duration": duration > 0 ? duration as Any : NSNull(), "p_state": state, "p_rate": 1], userId: userId)
+    }
+    public func purchase(itemId: String, requestId: UUID, userId: String) async throws -> PurchaseReceipt {
+        try await decode("anivibe_shop_purchase", body: ["p_item": itemId, "p_request": requestId.uuidString], userId: userId)
+    }
+    public func equip(slot: String, itemId: String?, userId: String) async throws {
+        _ = try await rpc("anivibe_cosmetic_equip", body: ["p_slot": slot, "p_item": itemId.map { $0 as Any } ?? NSNull()], userId: userId)
+    }
+    public func preferences(invites: String, hideWatching: Bool, userId: String) async throws {
+        _ = try await rpc("anivibe_preferences", body: ["p_invites": invites, "p_hide": hideWatching], userId: userId)
+    }
+    public func readNotification(_ id: String, userId: String) async throws -> Bool {
+        try await decode("anivibe_notification_read", body: ["p_id": id], userId: userId)
+    }
+    public func presentation(targetId: String, userId: String) async throws -> CosmeticPresentation {
+        try await decode("anivibe_cosmetic_profile", body: ["p_user": targetId], userId: userId)
+    }
+    private func decode<T: Decodable>(_ name: String, body: [String: Any], userId: String) async throws -> T {
+        let data = try await rpc(name, body: body, userId: userId)
+        let decoder = JSONDecoder(); decoder.keyDecodingStrategy = .convertFromSnakeCase
+        return try decoder.decode(T.self, from: data)
+    }
+    private func rpc(_ name: String, body: [String: Any], userId: String) async throws -> Data {
+        let session = try await auth.validSession()
+        guard session.user.id.lowercased() == userId.lowercased() else { throw CommunityError.wrongAccount }
+        let url = config.url.appendingPathComponent("rest/v1/rpc").appendingPathComponent(name)
+        var request = URLRequest(url: url); request.httpMethod = "POST"; request.timeoutInterval = 20
+        request.setValue(config.anonKey, forHTTPHeaderField: "apikey")
+        request.setValue("Bearer \(session.accessToken)", forHTTPHeaderField: "Authorization")
+        request.setValue("application/json", forHTTPHeaderField: "Content-Type")
+        request.httpBody = try JSONSerialization.data(withJSONObject: body)
+        let (data, response) = try await transport.send(request)
+        try Task.checkCancellation()
+        let current = await auth.currentSession
+        guard current?.user.id.lowercased() == userId.lowercased() else { throw CommunityError.wrongAccount }
+        guard (200..<300).contains(response.statusCode) else {
+            let fields = (try? JSONSerialization.jsonObject(with: data)) as? [String: Any] ?? [:]
+            if response.statusCode == 401 { throw AuthError.sessionExpired }
+            if ["PGRST202", "PGRST205", "42P01"].contains(fields["code"] as? String ?? "") { throw CommunityError.unavailable }
+            throw CommunityError.server(fields["message"] as? String ?? "server")
+        }
+        return data
+    }
+
+    /// Authenticated Supabase Postgres Changes, with cancellation and bounded reconnect.
+    /// Values are invalidations only: always refetch the authorized server snapshot.
+    public func invalidations(userId: String, roomId: String? = nil) -> AsyncStream<Void> {
+        AsyncStream(bufferingPolicy: .bufferingNewest(1)) { continuation in
+            let task = Task { [weak self] in
+                guard let self else { continuation.finish(); return }
+                #if canImport(FoundationNetworking)
+                // FoundationNetworking does not provide the Apple WebSocket implementation.
+                while !Task.isCancelled {
+                    continuation.yield(())
+                    do { try await Task.sleep(nanoseconds: 12_000_000_000) } catch { break }
+                }
+                #else
+                var backoff: UInt64 = 1
+                while !Task.isCancelled {
+                    do {
+                        let session = try await self.auth.validSession()
+                        guard session.user.id.lowercased() == userId.lowercased() else { break }
+                        var components = URLComponents(url: self.config.url, resolvingAgainstBaseURL: false)!
+                        components.scheme = components.scheme == "http" ? "ws" : "wss"
+                        components.path = "/realtime/v1/websocket"
+                        components.queryItems = [URLQueryItem(name: "apikey", value: self.config.anonKey), URLQueryItem(name: "vsn", value: "1.0.0")]
+                        guard let url = components.url else { break }
+                        let network = URLSession(configuration: .ephemeral)
+                        let socket = network.webSocketTask(with: url)
+                        let topic = "realtime:anivibe:\(roomId ?? userId)"
+                        let filters: [[String: String]]
+                        if let roomId {
+                            filters = [["event": "*", "schema": "public", "table": "watch_sessions", "filter": "id=eq.\(roomId)"]]
+                        } else {
+                            filters = [["event": "*", "schema": "public", "table": "community_notifications", "filter": "user_id=eq.\(userId)"],
+                                       ["event": "*", "schema": "public", "table": "watch_sessions", "filter": "host_id=eq.\(userId)"],
+                                       ["event": "*", "schema": "public", "table": "watch_sessions", "filter": "guest_id=eq.\(userId)"]]
+                        }
+                        socket.resume()
+                        let join: [String: Any] = ["topic": topic, "event": "phx_join", "ref": "1",
+                            "payload": ["access_token": session.accessToken, "config": ["postgres_changes": filters]]]
+                        let joinData = try JSONSerialization.data(withJSONObject: join)
+                        let expiry = Task {
+                            do {
+                                let seconds = max(1, min(1500, session.expiresAt.timeIntervalSinceNow - 30))
+                                try await Task.sleep(nanoseconds: UInt64(seconds * 1_000_000_000))
+                                socket.cancel(with: .goingAway, reason: nil)
+                            } catch { }
+                        }
+                        let heartbeat = Task {
+                            while !Task.isCancelled {
+                                do {
+                                    try await Task.sleep(nanoseconds: 25_000_000_000)
+                                    try await socket.send(.string("{\"topic\":\"phoenix\",\"event\":\"heartbeat\",\"payload\":{},\"ref\":\"heartbeat\"}"))
+                                } catch { socket.cancel(with: .goingAway, reason: nil); break }
+                            }
+                        }
+                        defer { expiry.cancel(); heartbeat.cancel(); socket.cancel(with: .goingAway, reason: nil); network.invalidateAndCancel() }
+                        try await withTaskCancellationHandler(operation: {
+                            try await socket.send(.string(String(decoding: joinData, as: UTF8.self)))
+                            while !Task.isCancelled {
+                                let message = try await socket.receive()
+                                let raw: Data
+                                switch message { case .data(let data): raw = data; case .string(let text): raw = Data(text.utf8); @unknown default: continue }
+                                let object = (try? JSONSerialization.jsonObject(with: raw)) as? [String: Any]
+                                let event = object?["event"] as? String
+                                if event == "phx_error" || event == "phx_close" { throw CommunityError.server("realtime_disconnected") }
+                                if event == "phx_reply", object?["ref"] as? String == "1" {
+                                    let payload = object?["payload"] as? [String: Any]
+                                    guard payload?["status"] as? String == "ok" else { throw CommunityError.server("realtime_disconnected") }
+                                    backoff = 1; continuation.yield(())
+                                }
+                                if event == "postgres_changes" { continuation.yield(()) }
+                            }
+                        }, onCancel: { socket.cancel(with: .goingAway, reason: nil); network.invalidateAndCancel() })
+                    } catch { if Task.isCancelled { break } }
+                    do { try await Task.sleep(nanoseconds: backoff * 1_000_000_000) } catch { break }
+                    backoff = min(30, backoff * 2)
+                }
+                #endif
+                continuation.finish()
+            }
+            continuation.onTermination = { _ in task.cancel() }
+        }
+    }
+}
